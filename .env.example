# Tunnel IDs: Zero Trust > Networks > Tunnels
HOME_TUNNEL_ID=
ALT_TUNNEL_ID=
# Telegram bot, for the watchdog's notifications (token from @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
